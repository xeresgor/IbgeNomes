<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Os testes compilam os mesmos arquivos das camadas Models, Services e ViewModels do app.
    Isso só é possível porque essas camadas não dependem de nada do MAUI: é a prova de que
    a separação em camadas está de pé.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\IbgeNomes\Models\**\*.cs" Link="App\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\IbgeNomes\Services\**\*.cs" Link="App\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\IbgeNomes\ViewModels\**\*.cs" Link="App\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
